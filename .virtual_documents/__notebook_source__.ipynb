import os, sys, json, hashlib, subprocess, platform, datetime
os.chdir("/kaggle/working")

# 1) Ghi thông tin môi trường
env = {
    "time_utc": datetime.datetime.utcnow().isoformat(),
    "python": sys.version,
    "platform": platform.platform(),
    "pip_freeze": subprocess.run([sys.executable, "-m", "pip", "freeze"],
                                 capture_output=True, text=True).stdout.splitlines(),
}
try:
    env["ollama"] = subprocess.run(["ollama", "--version"], capture_output=True, text=True).stdout.strip()
except Exception as e:
    env["ollama"] = str(e)
json.dump(env, open("ENV.json", "w"), indent=2)

# 2) Checksum mọi file kết quả (bỏ file >200MB, thường là model/cache)
SKIP = (".ollama", "__pycache__", ".cache")
rows = []
for root, dirs, files in os.walk("."):
    dirs[:] = [d for d in dirs if not d.startswith(SKIP)]
    for fn in files:
        p = os.path.join(root, fn)
        s = os.path.getsize(p)
        if s > 200 * 1024**2:
            print("BỎ QUA (lớn):", p, s // 1024**2, "MB"); continue
        h = hashlib.sha256(open(p, "rb").read()).hexdigest()
        rows.append(f"{h}  {s:>12}  {p}")
open("SHA256SUMS.txt", "w").write("\n".join(sorted(rows, key=lambda r: r.split()[-1])))
print(len(rows), "file đã ghi checksum")

# 3) Nén
stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M")
zipname = f"results_{stamp}.zip"
get_ipython().getoutput("zip -r -q {zipname} . -x "*.zip" "*/.ollama/*" "*/__pycache__/*" "*/.cache/*" -x@<(find . -size +200M)")
get_ipython().getoutput("ls -lh {zipname}")

