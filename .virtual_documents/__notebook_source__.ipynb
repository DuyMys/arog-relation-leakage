def find(name):
    matches = [
        path for path in Path("/kaggle/input").rglob(f"upload/{name}")
        if path.is_dir()
    ]
    if len(matches) != 1:
        raise RuntimeError(
            f"Cần đúng 1 thư mục upload/{name}, tìm thấy {len(matches)}: {matches}"
        )
    return matches[0]
