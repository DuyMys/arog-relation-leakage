def jsonl_to_json(jsonl_file, json_file):
    with open(jsonl_file, 'r') as infile:
        with open(json_file, 'w') as outfile:
            json_lines = infile.readlines()
            json_list = [json.loads(line) for line in json_lines]
            json.dump(json_list, outfile, indent=4)


def run_llm(prompt, temperature, max_tokens, opeani_api_keys, engine="gpt-3.5-turbo"):
    payload = {
        "model": OLLAMA_MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "stream": False,
        "options": {
            "temperature": temperature,
            "num_predict": max(max_tokens, 1024),
            "num_ctx": 8192,
        },
    }
    result = ""
    token_num = {"total": 0, "input": 0, "output": 0}
    for attempt in range(3):
        try:
            response = requests.post(OLLAMA_URL, json=payload, timeout=300)
            response.raise_for_status()
            data = response.json()
            result = data["message"]["content"]
            # phòng trường hợp model in cả phần suy luận
            result = re.sub(r"<think>.*?</think>", "", result, flags=re.DOTALL).strip()
            p = data.get("prompt_eval_count", 0)
            o = data.get("eval_count", 0)
            token_num = {"total": p + o, "input": p, "output": o}
            break
        except Exception as e:
            print("Lỗi gọi Ollama:", e)
            time.sleep(3)

    logging.info(result)
    logging.info(token_num)
    return result, token_num


def generate_without_explored_paths(question, args):
